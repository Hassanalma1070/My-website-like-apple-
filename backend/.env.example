PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname
# Comma-separated list of allowed origins, or * to allow any origin
CORS_ORIGIN=*
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Secret for signing login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Frontend address used in password reset links
FRONTEND_URL=http://localhost:5173
